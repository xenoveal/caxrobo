data/*.db
# SQLite WAL/SHM sidecars. data/*.db alone does NOT cover them, so a WAL-mode
# database leaks two derived files into git status (v0.3.0 contract §6).
data/*.db-wal
data/*.db-shm
# UI run bookkeeping (v0.3.0 Phase 7): a pid, an argv, a status and a log per
# run, all derived and reproducible — deleting this directory loses nothing
# of value. data/*.db does not match a directory, hence a separate line.
data/ui_runs/
.env
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Machine- and editor-local files. These were previously ignored ONLY via this
# machine's ~/.gitignore_global, so any other clone would have committed them.
# settings.local.json in particular carries local tool-permission config.
.DS_Store
**/.claude/settings.local.json

